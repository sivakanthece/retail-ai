# ── Copy this file to .env and fill in your values ───────────────────────────
# Never commit .env — it is listed in .gitignore

# ── Core ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (default):
DATABASE_URL=sqlite:///./retail.db
# Hugging Face Spaces — set this in Space Secrets after enabling Persistent Storage:
# DATABASE_URL=sqlite:////data/retail.db
# PostgreSQL (for external managed DB — Supabase/Neon free tier):
# DATABASE_URL=postgresql://user:password@host:5432/retaildb

# ── AI Vision providers (at least one required for LLM identification) ────────
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# ── Model settings ────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
# Set to best.pt if you have a custom-trained YOLOv8 model in backend/
YOLO_MODEL=yolov8n.pt
MAX_UPLOAD_SIZE_MB=20
